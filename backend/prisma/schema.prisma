datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Admin Model for authentication
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Hashed password
  role      String   @default("ADMIN") // ADMIN, EDITOR
  createdAt DateTime @default(now())
}

// Year-wise and Class-wise Student Admissions Record
model Student {
  id           Int      @id @default(autoincrement())
  name         String
  fatherName   String
  motherName   String
  address      String
  contactNo    String
  academicYear String   // e.g. "2025-26", "2026-27"
  classLevel   String   // e.g. "Class 1", "Nursery", etc.
  referenceId  String   @unique // Registration reference code
  status       String   @default("Pending") // Pending, Under Review, Approved, Rejected
  createdAt    DateTime @default(now())
}

// Dynamic Fee Structure per class level
model FeeStructure {
  id             Int      @id @default(autoincrement())
  classLevel     String
  medium         String   @default("English") // "English" or "Hindi"
  tuitionFee     Float
  admissionFee   Float
  developmentFee Float
  annualCharges  Float
  updatedAt      DateTime @updatedAt
}

// Media Assets uploaded by Admin to Cloudinary or locally
model Media {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique // Cloudinary public_id or local filename
  url       String   // Secure image/video URL
  category  String   // e.g. "slideshow", "gallery", "hostel", "facilities"
  title     String?  // Optional visual title description
  createdAt DateTime @default(now())
}

// Faculty details uploaded and managed by Admin
model Faculty {
  id           Int      @id @default(autoincrement())
  name         String
  designation  String   // e.g. "HOD Science", "Mathematics Teacher"
  qualification String  // e.g. "Ph.D. in Physics, 10 Years Exp"
  avatar       String?  // Avatar emoji or image URL (default emoji)
  createdAt    DateTime @default(now())
}
